### Android ###
# Gradle 빌드 산출물
.gradle/
.kotlin/
**/build/
!src/**/build/   # src 내부 build 폴더는 무시하지 않음

# 로컬 환경 설정 (SDK 경로 등)
local.properties

# 로그 파일
*.log

# 캡처, 프로파일링 결과물
captures/
*.hprof

# 외부 네이티브 빌드 산출물
.externalNativeBuild/
.cxx/
obj/

# APK / AAB / 임시 출력
*.apk
*.ap_
*.aab
output.json

# 서명 키
*.jks
*.keystore
.signing/

# ProGuard 결과물
proguard/

# Google 서비스 키
google-services.json

# 임시 파일
*~
*.swp

# Java crash logs
hs_err_pid*
replay_pid*

### Kotlin ###
# 컴파일된 클래스
*.class

# JAR / WAR / 기타 패키징
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# J2ME 임시
.mtj.tmp/

# BlueJ
*.ctxt

### Gradle ###
# Gradle 캐시
.gradletasknamecache
gradle-app.setting

# Gradle Wrapper 예외 처리
!gradle-wrapper.jar
!gradle-wrapper.properties

